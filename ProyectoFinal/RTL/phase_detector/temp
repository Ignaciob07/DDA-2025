
// ############ HALF LUT

    reg  [14    - 1 : 0] index                 ;
    reg  [8  - 1 : 0] data_i                ;
    reg  [8  - 1 : 0] data_q                ;

    always @(*) begin
        if(i_in_phase[NB_IN_PD  - 1])                   
            data_i = ~i_in_phase + 1;                     
        else                                            
            data_i = i_in_phase;                           

        if(i_quadrature[NB_IN_PD  - 1])                   
            data_q = ~i_quadrature + 1;                     
        else                                            
            data_q = i_quadrature;                          

        if(data_q == 8'b10000000)                       
           index [6-:7] = 7'b1111111;
        else                       
           index [6-:7] = data_q;

        if(data_i == 8'b10000000)                       
           index [13-:7] = 7'b1111111;
        else                       
           index [13-:7] = data_i;
                                                           
    end

    lut_atan_only #(
        .NB_DATA_INDEX  (14),
        .NB_DATA_OUT    (9)    
    ) u_lut_r (
        .o_atan     (phase_r),
        .i_index    (index),
        .i_clock    (i_clock),
        .i_rst_n    (i_rst_n)
    );

    always @(*) begin
        if(i_in_phase[NB_IN_PD - 1] && !i_quadrature[NB_IN_PD - 1]) begin
            phase_a_converted = PI_17_14 - phase_a;
            phase_r_converted = PI_17_14 - phase_r;
        end
        
        else if(i_in_phase[NB_IN_PD - 1] && i_quadrature[NB_IN_PD - 1]) begin
            phase_a_converted = $signed(~(PI_17_14 - phase_a ) + 1);
            phase_r_converted = $signed(~(PI_17_14 - phase_r ) + 1);
        end
        
        else if(!i_in_phase[NB_IN_PD - 1] && i_quadrature[NB_IN_PD - 1]) begin
            phase_a_converted = $signed(~phase_a + 1) ;
            phase_r_converted = $signed(~phase_r + 1) ;
        end

        else begin
            phase_a_converted = phase_a;
            phase_r_converted = phase_r;
        end

        r_phase_error = $signed(phase_r_converted) - $signed(phase_a_converted);

    end